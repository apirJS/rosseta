{
  "name": "rosseta",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev:chrome": "NODE_ENV=development TARGET=chrome vite dev",
    "dev:firefox": "NODE_ENV=development TARGET=firefox vite dev",
    "build:dev:chrome": "NODE_ENV=development TARGET=chrome vite build --watch --mode development",
    "build:dev:firefox": "NODE_ENV=development TARGET=firefox vite build --watch --mode development",
    "build:prod:chrome": "NODE_ENV=production TARGET=chrome vite build",
    "build:prod:firefox": "NODE_ENV=production TARGET=firefox vite build",
    "build:prod": "bun run build:prod:chrome && bun run build:prod:firefox",
    "test:logic": "bun test src/shared src/core src/adapters/primary/background src/adapters/primary/content src/adapters/secondary",
    "test:ui": "vitest run src/adapters/primary/ui",
    "test": "bun run test:logic && bun run test:ui",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitest/coverage-v8": "5.0.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "jsdom": "^30.0.1",
    "semantic-release": "^25.0.9",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/deepinfra": "^3.0.48",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/groq": "^4.0.41",
    "@ai-sdk/huggingface": "^2.0.49",
    "@ai-sdk/mistral": "^4.0.43",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@ai-sdk/xai": "^4.0.58",
    "@ai-sdk/zai": "^3.0.10",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@openrouter/sdk": "^1.2.123",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.99",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.2"
  }
}
